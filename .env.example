# ===================================================
# Nature Club Management System - Environment Variables
# Copy this file to .env and set your secrets.
# NEVER commit your real .env file into version control.
# ===================================================

# SQLite Database connection string
# Points to local SQLite database in the prisma/ directory
DATABASE_URL="file:./dev.db"

# NextAuth / Auth.js secret key
# Generate a secure key in production (e.g. `openssl rand -base64 32`)
AUTH_SECRET="nature-club-super-secret-key-change-in-production-32chars"
NEXTAUTH_URL="http://localhost:3000"

# Initial Administrator account created by `npm run db:seed`
ADMIN_EMAIL="admin@natureclub.org"
ADMIN_PASSWORD="NatureAdmin2026!Secure"
ADMIN_NAME="Chief Club Warden"
